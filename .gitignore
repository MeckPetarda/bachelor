# Godot 4+ specific files
.godot/

# Godot-specific ignores
*.tmp
*.import

# Export presets (contains sensitive information like keystore paths)
export_presets.cfg

# Imported translations (generated from CSV files)
*.translation

# C# / Mono specific ignores
.mono/
data_*/
mono_crash.*.json
*.csproj
*.sln
bin/
obj/

# System/editor files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
builds/
dist/
*.exe
*.pck
*.zip
*.apk
*.aab
*.ipa

# Android build directory (entire folder)
android/

# Gradle files
.gradle/
gradle/
gradlew
gradlew.bat
local.properties
gradle.properties

# iOS specific (if building for iOS)
ios/

# Logs
logs/
*.log

# Temporary files
*.tmp
temp/

# Tree output file (your documentation file)
tree.md

# Plugin binaries (exclude compiled libraries but keep plugin configs)
addons/*/bin/
addons/*/*.so
addons/*/*.dll
addons/*/*.dylib
addons/*/linux/
addons/*/macos/
addons/*/win64/

# But keep plugin configurations
!addons/*/plugin.cfg
!addons/*/plugin.gdextension
!addons/*/plugin.gdextension.uid
!addons/*/LICENSE*
!addons/*/README*
!addons/*/*.md

# Asset source files (optional - uncomment if you don't want to track source assets)
# *.blend
# *.blend1
# *.psd
# *.xcf
# *.ai
